# =============================================================================
# Cliprank Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will NOT be committed to source control.
#
# In Vite, only variables prefixed with VITE_ are exposed to the browser.
# =============================================================================


# -----------------------------------------------------------------------------
# WebSocket Server URL (required for live processing updates)
# -----------------------------------------------------------------------------
# The base URL of your backend WebSocket server (no trailing slash).
# The app connects to: {VITE_WS_URL}/ws/jobs/{jobId}
#
# Examples:
#   Local dev:   ws://localhost:8000
#   Production:  wss://api.cliprank.io
VITE_WS_URL=


# -----------------------------------------------------------------------------
# Backend REST API Base URL (required for job submission & clip fetching)
# -----------------------------------------------------------------------------
# The base URL of your FastAPI/Express backend (no trailing slash).
# Used for:
#   POST {VITE_API_URL}/api/videos          — Submit a new video URL
#   GET  {VITE_API_URL}/api/videos/{id}     — Fetch job status
#   GET  {VITE_API_URL}/api/videos/{id}/clips — Fetch ranked clips
#
# Examples:
#   Local dev:   http://localhost:8000
#   Production:  https://api.cliprank.io
#
# If left blank, the app uses mock data for the Gallery and History pages.
VITE_API_URL=


# -----------------------------------------------------------------------------
# App Environment
# -----------------------------------------------------------------------------
# Controls demo mode banners and logging verbosity.
# Values: development | staging | production
VITE_APP_ENV=development


# -----------------------------------------------------------------------------
# Feature Flags (optional)
# -----------------------------------------------------------------------------
# Set to "true" to enable features that are still in development.

# Show the "Post to social" button on approved clips
VITE_FEATURE_SOCIAL_POSTING=false

# Enable AI caption style selector on the Submit page
VITE_FEATURE_CAPTION_STYLES=false
