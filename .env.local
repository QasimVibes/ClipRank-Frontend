# =============================================================================
# Cliprank Frontend — Local Development Environment
# =============================================================================
# This file is gitignored (*.local pattern). Do NOT commit it.
# To get started, fill in the values below.
# See .env.example for full documentation of each variable.
# =============================================================================

# WebSocket server
VITE_WS_URL=ws://127.0.0.1:8000

# REST API base URL
VITE_API_URL=http://127.0.0.1:8000

# App environment
VITE_APP_ENV=development

# Feature flags
VITE_FEATURE_SOCIAL_POSTING=false
VITE_FEATURE_CAPTION_STYLES=false
